+test("Linux shutdown attempts all children and retains failed discarded owners", async () => {
+  if (process.platform !== "linux") return;
+  const stuck = {close: vi.fn(async () => { throw new Error("stuck owned child"); })};
+  const good = {close: vi.fn(async () => {})};
+  const manager = new DeviceManager(async () => stuck as unknown as HelperProcess);
+  const internal = manager as any;
+  internal.scanHelper = stuck;
+  await internal.discardScanHelper();
+  internal.watcher = good;
+  internal.registry.set("synthetic", {helper: good});
+  await expect(manager.shutdown()).rejects.toThrow("Linux helper shutdown failed");
+  expect(stuck.close).toHaveBeenCalledTimes(2);
+  expect(good.close).toHaveBeenCalledTimes(1);
+  await expect(manager.shutdown()).rejects.toThrow("Linux helper shutdown failed");
+  expect(stuck.close).toHaveBeenCalledTimes(3);
+});
